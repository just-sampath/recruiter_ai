# ================================
# Recruiter AI Environment Variables
# ================================
# Copy this file to .env and fill in your API keys
# For Docker: docker-compose up -d
# ================================

# External API Keys (required for AI features)
OPENAI_API_KEY=
# Used by Gemini LLM + embeddings (GeminiEmbedding also accepts GEMINI_API_KEY)
GOOGLE_API_KEY=
# Optional alias for dense embeddings only
# GEMINI_API_KEY=
COHERE_API_KEY=

# Security (change in production!)
JWT_SECRET=replace-me-with-secure-secret
# Required for POST /api/internal/init (empty token → 503 in shared/prod)
INTERNAL_INIT_TOKEN=

# Superadmin credentials (created on first startup)
# SUPERADMIN_EMAIL=superadmin@example.com
# SUPERADMIN_PASSWORD=SuperAdmin@123!

# Sparse embeddings: set true for higher-quality BM42 ONNX path; otherwise tokenizer fallback
# BM42_ENABLE=true

# ================================
# Qdrant (local Docker default below)
# For Qdrant Cloud:
#   QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
#   QDRANT_API_KEY=your-cloud-api-key
# Port is optional for Cloud HTTPS URLs.
# Truncate+import recreates the collection named in config (qdrant.collection) — irreversible.
# ================================
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ================================
# Below are pre-configured for Docker
# Only modify if running locally without Docker
# ================================
# PORT=3000
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/recruiter_ai
# REDIS_HOST=localhost
# REDIS_PORT=6379
# QDRANT_URL=http://localhost:6333
